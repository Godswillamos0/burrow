# ==============================================================================
# BURROW WAITLIST - ENVIRONMENT CONFIGURATION
# Copy to .env.local for local dev; set the same keys in the Render dashboard.
# ==============================================================================

# --- 1. Supabase (REQUIRED in production) -------------------------------------
# Project Settings -> API. Without these, production refuses sign-ups instead of
# silently keeping them in memory.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase provider id for X sign-in: "x" (OAuth 2.0, default) or "twitter" (legacy OAuth 1.0a)
# NEXT_PUBLIC_SUPABASE_X_PROVIDER=x

# --- 2. Site URL (used for link previews and referral links) ------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- 3. Admin export (REQUIRED to use /api/admin/export) ----------------------
# Long random string, 16+ characters. e.g.  openssl rand -hex 32
ADMIN_SECRET_KEY=

# --- 4. Wallet connect ---------------------------------------------------------
# Free project ID from https://cloud.reown.com (WalletConnect). Needed for mobile
# wallets via QR / deep link. Without it only browser-extension wallets work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Secret for signing wallet nonces (falls back to SUPABASE_SERVICE_ROLE_KEY)
# NONCE_SECRET=

# --- 5. Cloudflare Turnstile bot protection (recommended) ---------------------
# Cloudflare dashboard -> Turnstile -> Add widget (add your domain + onrender.com host)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- 6. Upstash Redis rate limiting (optional, recommended) -------------------
# Without it, a per-instance in-memory limiter is used (5 sign-up attempts/IP/hour).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- 7. Robinhood Chain (EVM 4663) --------------------------------------------
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
